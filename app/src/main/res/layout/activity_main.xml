<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/header_blue"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/header_title"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/refreshButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/headerCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="start"
            android:layout_height="wrap_content"
            android:textColor="@color/header_blue_sub"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/permissionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEBEE"
        android:textColor="#C62828"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone"
        android:text="@string/permission_denied" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

    <!-- Visual parity with the original's "התקן הכל" button — present so the
         screen matches pixel-for-pixel, but intentionally inert here: this
         build stays view-only, per the original decision not to install
         anything. Wire installAllButton up only if that decision changes. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/installAllButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="התקן הכל"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingVertical="0dp"
        android:minHeight="0dp"
        android:background="@drawable/bg_install_all_button"
        android:backgroundTint="@null" />

    <ProgressBar
        android:id="@+id/installAllProgress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFF"
        android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
